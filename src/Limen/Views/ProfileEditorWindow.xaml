<Window x:Class="Limen.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Limen"
        xmlns:local="clr-namespace:Limen"
        Title="{loc:T Editor.Title}" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Panel}" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource Field}"/>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource Secret}"/>
        <Style TargetType="TextBlock" BasedOn="{StaticResource FormLabel}"/>

        <!-- Section rule + caption, repeated for each group of fields. -->
        <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,0,0,1" Padding="22,16">
            <StackPanel>
                <TextBlock x:Name="HeadingText" Text="{loc:T Editor.Title}" Style="{StaticResource TitleText}" FontSize="15"/>
                <TextBlock x:Name="SubheadingText" Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="{loc:T Editor.Subtitle}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="22,18,22,4">

            <!-- ============================ 연결 ============================ -->
            <TextBlock Text="{loc:T Editor.GroupConnection}" Style="{StaticResource GroupTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="122"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="86"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{loc:T Editor.SessionName}"/>
                <TextBox x:Name="NameBox" Grid.Column="1" Grid.ColumnSpan="4"
                         local:Ui.Placeholder="{loc:T Editor.NamePlaceholder}"/>

                <TextBlock Grid.Row="1" Text="{loc:T Editor.Folder}"/>
                <TextBox x:Name="FolderBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
                         local:Ui.Placeholder="{loc:T Editor.FolderPlaceholder}"
                         ToolTip="{loc:T Editor.FolderHint}"/>

                <TextBlock Grid.Row="2" Text="{loc:T Editor.Host}"/>
                <TextBox x:Name="HostBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource MonoField}"
                         local:Ui.Placeholder="{loc:T Editor.HostPlaceholder}"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{loc:T Editor.Port}" Margin="0,0,10,0"/>
                <TextBox x:Name="PortBox" Grid.Row="2" Grid.Column="4" Style="{StaticResource MonoField}"/>

                <TextBlock Grid.Row="3" Text="{loc:T Editor.Colour}" VerticalAlignment="Top" Margin="0,7,12,0"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,3,0,0">
                    <StackPanel x:Name="ColorPicker" Orientation="Horizontal"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="{loc:T Editor.ColourHint}"/>
                </StackPanel>
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,16"/>

            <!-- ============================ 인증 ============================ -->
            <TextBlock Text="{loc:T Editor.GroupAuth}" Style="{StaticResource GroupTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="122"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{loc:T Editor.User}"/>
                <TextBox x:Name="UserBox" Grid.Column="1" Style="{StaticResource MonoField}"
                         local:Ui.Placeholder="root"/>

                <TextBlock Grid.Row="1" Text="{loc:T Editor.AuthMode}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="PasswordAuth" Content="{loc:T Editor.Password}" IsChecked="True" Margin="0,0,22,0"
                                 Checked="AuthMode_Changed"/>
                    <RadioButton x:Name="KeyAuth" Content="{loc:T Editor.PrivateKey}" Checked="AuthMode_Changed"/>
                </StackPanel>

                <Grid x:Name="PasswordRow" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="122"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:T Editor.Password}" VerticalAlignment="Top" Margin="0,6,12,0"/>
                    <StackPanel Grid.Column="1">
                        <PasswordBox x:Name="PasswordBoxCtl"
                                     local:Ui.Placeholder="{loc:T Editor.PasswordPlaceholder}"/>
                        <TextBlock x:Name="PasswordHint" Style="{StaticResource Hint}" Margin="0,7,0,0"
                                   Text="{loc:T Editor.PasswordHint}"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="KeyRow" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="122"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:T Editor.KeyFile}"/>
                    <TextBox x:Name="KeyPathBox" Grid.Column="1" Style="{StaticResource MonoField}"
                             local:Ui.Placeholder="%USERPROFILE%\.ssh\id_ed25519"/>
                    <Button Grid.Column="2" Style="{StaticResource FlatButton}" Margin="8,0,0,0"
                            MinWidth="86" Click="BrowseKey_Click" Content="{loc:T Common.Browse}"/>
                    <TextBlock Grid.Row="1" Text="{loc:T Editor.Passphrase}" Margin="0,6,12,0"/>
                    <PasswordBox x:Name="PassphraseBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                 Margin="0,6,0,0" local:Ui.Placeholder="{loc:T Editor.PassphrasePlaceholder}"/>
                </Grid>
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,16"/>

            <!-- ========================== Bastion ========================== -->
            <TextBlock Text="{loc:T Editor.GroupBastion}" Style="{StaticResource GroupTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="122"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:T Editor.JumpHost}"/>
                <ComboBox x:Name="JumpProfileBox" Grid.Column="1" DisplayMemberPath="Label"/>
                <TextBlock x:Name="JumpHint" Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}"
                           Text="{loc:T Editor.NoJumpHint}" Margin="0,7,0,0"/>
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,16"/>

            <!-- ========================== 시작 위치 ========================== -->
            <TextBlock Text="{loc:T Editor.GroupStartup}" Style="{StaticResource GroupTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="122"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="38"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{loc:T Editor.RemotePath}"/>
                <TextBox x:Name="RemoteDirBox" Grid.Column="1" Style="{StaticResource MonoField}"
                         local:Ui.Placeholder="{loc:T Editor.RemotePlaceholder}"
                         ToolTip="{loc:T Editor.RemoteHint}"/>
                <TextBlock Grid.Row="1" Text="{loc:T Editor.LocalPath}"/>
                <TextBox x:Name="LocalDirBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource MonoField}"
                         local:Ui.Placeholder="{loc:T Editor.LocalPlaceholder}"/>
                <TextBlock Grid.Row="2" Text="{loc:T Editor.LoginCommand}"/>
                <TextBox x:Name="LoginCommandBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource MonoField}"
                         local:Ui.Placeholder="{loc:T Editor.CommandPlaceholder}"
                         ToolTip="{loc:T Editor.CommandHint}"/>
            </Grid>

            <!-- Host key trust state, shown as a quiet fact rather than a warning. -->
            <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IcoSoft}" Data="{StaticResource IcoKey}" Margin="0,0,10,0"
                          VerticalAlignment="Top"/>
                    <TextBlock x:Name="FingerprintText" Style="{StaticResource Hint}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10.5" MaxWidth="470"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Inline validation instead of a modal on top of a modal. -->
        <Border x:Name="ErrorBar" Grid.Row="2" Background="{DynamicResource DangerSoft}" Padding="22,10"
                Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource Danger}" VerticalAlignment="Center"
                         Margin="0,0,10,0"/>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" FontSize="12"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="500"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="22,14" Margin="0,14,0,0">
            <DockPanel>
                <Button x:Name="ForgetButton" DockPanel.Dock="Left" Style="{StaticResource DangerButton}"
                        MinWidth="118" Content="{loc:T Editor.ForgetCredentials}" HorizontalAlignment="Left" Click="Forget_Click"
                        ToolTip="{loc:T Editor.ForgetHint}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:T Common.Cancel}" Style="{StaticResource FlatButton}" IsCancel="True" Margin="0,0,8,0"/>
                    <Button Content="{loc:T Common.Save}" Style="{StaticResource PrimaryButton}" MinWidth="88" IsDefault="True"
                            Click="Save_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
