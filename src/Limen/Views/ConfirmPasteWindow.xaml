<Window x:Class="Limen.ConfirmPasteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Limen"
        Title="{loc:T Paste.Title}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Panel}" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="22,20,22,18">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource DangerSoft}"
                        VerticalAlignment="Top">
                    <TextBlock Text="!" Foreground="{DynamicResource Danger}" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center" MaxWidth="440">
                    <TextBlock x:Name="HeadingText" Style="{StaticResource TitleText}" FontSize="14"
                               TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource Muted}"
                               Text="{loc:T Paste.Body}"/>
                </StackPanel>
            </StackPanel>

            <Border Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1" CornerRadius="6" Padding="12,10" MaxHeight="220">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="PreviewText" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                               Foreground="{DynamicResource Ink}" TextWrapping="NoWrap"/>
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="MoreText" Style="{StaticResource Hint}" Margin="0,7,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="22,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:T Common.Cancel}" Style="{StaticResource FlatButton}" IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="AcceptButton" Style="{StaticResource PrimaryButton}" MinWidth="112"
                        IsDefault="True" Click="Accept_Click" Content="{loc:T Common.Paste}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
