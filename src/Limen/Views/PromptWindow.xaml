<Window x:Class="Limen.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Limen"
        xmlns:local="clr-namespace:Limen"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Panel}" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="22,20,22,18">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentSoft}"
                        VerticalAlignment="Top">
                    <Path Data="{StaticResource IcoKey}" Stretch="Uniform" Margin="8"
                          Stroke="{DynamicResource Accent}" StrokeThickness="1.3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center" MaxWidth="350">
                    <TextBlock x:Name="HeadingText" Style="{StaticResource TitleText}" FontSize="14"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageText" Style="{StaticResource Hint}" FontSize="12"
                               Margin="0,4,0,0" Foreground="{DynamicResource Muted}"/>
                </StackPanel>
            </StackPanel>

            <PasswordBox x:Name="MaskedBox" Style="{StaticResource Secret}" Height="32"
                         local:Ui.Placeholder="{loc:T Prompt.Placeholder}" KeyDown="Box_KeyDown"/>
            <TextBox x:Name="PlainBox" Style="{StaticResource Field}" Height="32" Visibility="Collapsed"
                     local:Ui.Placeholder="{loc:T Prompt.Placeholder}" KeyDown="Box_KeyDown"/>

            <CheckBox x:Name="RememberBox" Content="{loc:T Prompt.Remember}"
                      Margin="0,14,0,0" FontSize="12" Foreground="{DynamicResource Muted}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0" Padding="22,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:T Common.Cancel}" Style="{StaticResource FlatButton}" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="{loc:T Common.Ok}" Style="{StaticResource PrimaryButton}" MinWidth="88" IsDefault="True"
                        Click="Accept_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
