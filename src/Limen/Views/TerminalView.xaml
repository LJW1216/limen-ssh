<UserControl x:Class="Limen.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource TerminalBack}">
    <Grid>
        <!-- WebView2 는 HwndHost 라 WPF 요소를 그 위에 겹칠 수 없다. 접속 상태와
             오류는 터미널 화면 안에 직접 찍고, 아래 안내문은 WebView2 자체를
             띄우지 못했을 때만 보인다. -->
        <TextBlock x:Name="FallbackText" Foreground="{DynamicResource Ink}" FontFamily="{StaticResource MonoFont}"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        <wv2:WebView2 x:Name="Browser"/>
    </Grid>
</UserControl>
