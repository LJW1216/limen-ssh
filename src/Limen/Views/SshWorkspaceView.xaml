<UserControl x:Class="Limen.SshWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Limen"
             Background="{DynamicResource Panel}">
    <UserControl.Resources>
        <!-- One gauge stacks three lines: name + percentage, bar, raw figures.
             The figures stay on screen — for a server they are the point, not
             a tooltip detail. -->
        <Style x:Key="GaugeLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <Style x:Key="GaugeValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <Style x:Key="GaugeDetail" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="Gauge" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Value" Value="0"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="360"/>
            <ColumnDefinition x:Name="SplitterColumn" Width="5"/>
            <ColumnDefinition x:Name="SftpColumn" Width="2*" MinWidth="280"/>
            <ColumnDefinition Width="30"/>
        </Grid.ColumnDefinitions>

        <!-- Tag strip: the loudest possible reminder of which box this is. -->
        <Border x:Name="TagStrip" Grid.ColumnSpan="4" Height="3" Visibility="Collapsed"/>

        <Grid x:Name="TerminalHost" Grid.Row="1"/>

        <GridSplitter x:Name="PaneSplitter" Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

        <Grid x:Name="SftpHost" Grid.Row="1" Grid.Column="2">
            <Border Background="{DynamicResource Panel}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0">
                    <ProgressBar Width="180" Height="4" IsIndeterminate="True" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:T Workspace.SftpPending}"
                               Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Fixed rail so the toggle never floats over the terminal or the
             file list, and stays legible in both themes. -->
        <Border Grid.Row="1" Grid.Column="3" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}"
                BorderThickness="1,0,0,0">
            <StackPanel VerticalAlignment="Top" Margin="0,4,0,0">
                <Button x:Name="ToggleSftpButton" Style="{StaticResource IconButton}" Width="28" Height="28"
                        HorizontalAlignment="Center" ToolTip="{loc:T Workspace.CollapseSftp}" Click="ToggleSftp_Click">
                    <Path x:Name="ToggleIcon" Style="{StaticResource Ico}" Data="{StaticResource IcoPanel}"/>
                </Button>
                <TextBlock Text="SFTP" Style="{StaticResource SectionHeader}" HorizontalAlignment="Center"
                           Margin="0,10,0,0" FontSize="9.5">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>

                <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="6,14,6,10"
                           HorizontalAlignment="Stretch"/>

                <Button x:Name="LogButton" Style="{StaticResource IconButton}" Width="28" Height="28"
                        HorizontalAlignment="Center" ToolTip="{loc:T Workspace.StartLog}"
                        Click="ToggleLog_Click">
                    <Path x:Name="LogIcon" Style="{StaticResource Ico}" Data="{StaticResource IcoFile}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ========================= 서버 리소스 =========================
             Bar colour is the alarm (75% / 90%), never the metric's identity:
             a green memory bar at 95% would be worse than no bar at all. -->
        <Border Grid.Row="2" Grid.ColumnSpan="4" Background="{DynamicResource Chrome}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CpuColumn" Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition x:Name="GpuColumn" Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="CpuGauge" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock x:Name="CpuValue" DockPanel.Dock="Right" Text="—" Style="{StaticResource GaugeValue}"/>
                        <TextBlock Text="CPU" Style="{StaticResource GaugeLabel}"/>
                    </DockPanel>
                    <ProgressBar x:Name="CpuBar" Grid.Row="1" Style="{StaticResource Gauge}"/>
                    <TextBlock x:Name="CpuText" Grid.Row="2" Style="{StaticResource GaugeDetail}"/>
                </Grid>

                <Grid x:Name="MemoryGauge" Grid.Column="1" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock x:Name="MemoryValue" DockPanel.Dock="Right" Text="—" Style="{StaticResource GaugeValue}"/>
                        <TextBlock Text="{loc:T Metrics.Memory}" Style="{StaticResource GaugeLabel}"/>
                    </DockPanel>
                    <ProgressBar x:Name="MemoryBar" Grid.Row="1" Style="{StaticResource Gauge}"/>
                    <TextBlock x:Name="MemoryText" Grid.Row="2" Style="{StaticResource GaugeDetail}"/>
                </Grid>

                <Grid x:Name="GpuGauge" Grid.Column="2" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock x:Name="GpuValue" DockPanel.Dock="Right" Text="—" Style="{StaticResource GaugeValue}"/>
                        <TextBlock Text="GPU" Style="{StaticResource GaugeLabel}"/>
                    </DockPanel>
                    <ProgressBar x:Name="GpuBar" Grid.Row="1" Style="{StaticResource Gauge}"/>
                    <TextBlock x:Name="GpuText" Grid.Row="2" Style="{StaticResource GaugeDetail}"/>
                </Grid>

                <Grid x:Name="DiskGauge" Grid.Column="3" Margin="0,0,20,0"
                      ToolTip="{loc:T Sftp.RootFilesystem}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock x:Name="DiskValue" DockPanel.Dock="Right" Text="—" Style="{StaticResource GaugeValue}"/>
                        <TextBlock Text="{loc:T Metrics.Disk}" Style="{StaticResource GaugeLabel}"/>
                    </DockPanel>
                    <ProgressBar x:Name="DiskBar" Grid.Row="1" Style="{StaticResource Gauge}"/>
                    <TextBlock x:Name="DiskText" Grid.Row="2" Style="{StaticResource GaugeDetail}"/>
                </Grid>

                <StackPanel Grid.Column="4" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse x:Name="MetricsDot" Width="6" Height="6" Fill="{DynamicResource Idle}"
                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="MetricsStateText" Text="{loc:T Metrics.Waiting}" Style="{StaticResource Hint}"
                                   FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="MetricsTimeText" Text="" Style="{StaticResource Hint}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10"
                               HorizontalAlignment="Right" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
