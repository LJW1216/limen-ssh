<Window x:Class="Limen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Limen"
        xmlns:local="clr-namespace:Limen"
        Title="Limen" Icon="/Limen;component/Assets/AppIcon.ico"
        Height="780" Width="1240" MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Chrome}"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static local:MainWindow.NewSessionCommand}"/>
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.ReloadCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static local:MainWindow.FindCommand}"/>
        <KeyBinding Key="W" Modifiers="Control" Command="{x:Static local:MainWindow.CloseTabCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Control" Command="{x:Static local:MainWindow.NextTabCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{x:Static local:MainWindow.PrevTabCommand}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.NewSessionCommand}" Executed="New_Click"/>
        <CommandBinding Command="{x:Static local:MainWindow.ReloadCommand}" Executed="Reload_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.FindCommand}" Executed="Find_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.CloseTabCommand}" Executed="CloseActiveTab_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.NextTabCommand}" Executed="NextTab_Executed"/>
        <CommandBinding Command="{x:Static local:MainWindow.PrevTabCommand}" Executed="PrevTab_Executed"/>
    </Window.CommandBindings>

    <Window.Resources>
        <!-- Session tree row: folder or host, name, trailing detail. -->
        <HierarchicalDataTemplate DataType="{x:Type local:ProfileNode}" ItemsSource="{Binding Children}">
            <Grid Margin="0,3,8,3" Background="Transparent" ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path x:Name="Glyph" Style="{StaticResource IcoSoft}" Data="{StaticResource IcoServer}"
                      Margin="0,0,9,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="Label" Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink}"/>
                    <!-- The target belongs under the name: session names are long
                         and a trailing column would eat them. -->
                    <TextBlock x:Name="Target" Text="{Binding Subtitle}" Margin="0,1,0,0"
                               FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="Count" Grid.Column="2" Text="{Binding Subtitle}" VerticalAlignment="Center"
                           Margin="10,0,0,0" FontSize="10.5" Foreground="{DynamicResource Faint}"
                           Visibility="Collapsed"/>
            </Grid>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasColor}" Value="True">
                    <Setter TargetName="Glyph" Property="Stroke" Value="{Binding Accent}"/>
                    <Setter TargetName="Glyph" Property="StrokeThickness" Value="1.6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource IcoFolder}"/>
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Muted}"/>
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="Label" Property="FontSize" Value="11.5"/>
                    <Setter TargetName="Target" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Count" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ============================ TOOLBAR ============================
             Left: what is selected. Right: what you can do with it. -->
        <Border Style="{StaticResource Toolbar}">
            <Grid Margin="10,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Limen;component/Assets/AppIcon.ico" Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock Text="Limen" Margin="9,0,0,0" VerticalAlignment="Center"
                               FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
                    <Rectangle Style="{StaticResource Divider}" Margin="14,10"/>

                    <Path x:Name="SelIcon" Style="{StaticResource IcoSoft}" Data="{StaticResource IcoServer}"
                          Margin="0,0,8,0" Opacity="0.5"/>
                    <TextBlock x:Name="SelName" Text="{loc:T Main.NoSelection}" VerticalAlignment="Center"
                               FontSize="12.5" Foreground="{DynamicResource Faint}"
                               TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                    <TextBlock x:Name="SelTarget" VerticalAlignment="Center" Margin="10,0,0,0"
                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{DynamicResource Faint}"
                               TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SshButton" Style="{StaticResource PrimaryButton}" IsEnabled="False"
                            Click="OpenSsh_Click" ToolTip="{loc:T Main.OpenSshHint}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoTerminal}" Margin="0,0,8,0"/>
                            <TextBlock Text="{loc:T Main.SshTerminal}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SftpButton" Style="{StaticResource FlatButton}" IsEnabled="False"
                            Margin="6,0,0,0" Click="OpenSftp_Click" ToolTip="{loc:T Main.OpenSftpHint}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoTransfer}" Margin="0,0,8,0"/>
                            <TextBlock Text="{loc:T Main.SftpTransfer}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Style="{StaticResource Divider}" Margin="10,10"/>

                    <Button x:Name="EditButton" Style="{StaticResource IconButton}" IsEnabled="False"
                            Click="Edit_Click" ToolTip="{loc:T Main.EditHint}">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoPencil}"/>
                    </Button>
                    <Button x:Name="DuplicateButton" Style="{StaticResource IconButton}" IsEnabled="False"
                            Click="Duplicate_Click" ToolTip="{loc:T Main.DuplicateHint}">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoCopy}"/>
                    </Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" IsEnabled="False"
                            Click="Delete_Click" ToolTip="{loc:T Main.DeleteHint}">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoTrash}"/>
                    </Button>

                    <Rectangle Style="{StaticResource Divider}" Margin="10,10"/>

                    <Button x:Name="LanguageButton" Style="{StaticResource GhostButton}" MinWidth="34"
                            Click="Language_Click">
                        <TextBlock x:Name="LanguageText" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Click="Theme_Click">
                        <Path x:Name="ThemeIcon" Style="{StaticResource Ico}" Data="{StaticResource IcoMoon}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================= BODY ============================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="210"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="460"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar: search sits with the list it filters. -->
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="14,14,12,8">
                        <TextBlock Text="{loc:T Main.Sessions}" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="CountText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Style="{StaticResource SectionHeader}" FontWeight="Normal"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="12,0,12,10">
                        <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Padding="32,0,26,0"
                                 local:Ui.Placeholder="{loc:T Main.SearchPlaceholder}"
                                 TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"/>
                        <Path Style="{StaticResource IcoSoft}" Data="{StaticResource IcoSearch}"
                              HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False"/>
                        <Button x:Name="ClearSearch" Style="{StaticResource TabCloseButton}"
                                HorizontalAlignment="Right" Margin="0,0,7,0" Visibility="Collapsed"
                                ToolTip="{loc:T Main.ClearSearch}" Click="ClearSearch_Click"/>
                    </Grid>

                    <TreeView x:Name="SessionTree" Grid.Row="2" BorderThickness="0" Padding="8,0,4,8"
                              SelectedItemChanged="Tree_SelectionChanged" MouseDoubleClick="Tree_MouseDoubleClick"
                              KeyDown="Tree_KeyDown"
                              PreviewMouseRightButtonDown="Tree_RightButtonDown"
                              ContextMenuOpening="Tree_ContextMenuOpening">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:T Main.OpenSsh}" InputGestureText="Enter" Click="OpenSsh_Click">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IcoSoft}" Data="{StaticResource IcoTerminal}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:T Main.OpenSftp}" Click="OpenSftp_Click">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IcoSoft}" Data="{StaticResource IcoTransfer}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{loc:T Common.Edit}" InputGestureText="F2" Click="Edit_Click">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IcoSoft}" Data="{StaticResource IcoPencil}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:T Common.Duplicate}" Click="Duplicate_Click">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IcoSoft}" Data="{StaticResource IcoCopy}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:T Common.Delete}" InputGestureText="Delete" Click="Delete_Click">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IcoSoft}" Data="{StaticResource IcoTrash}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>

                    <Border Grid.Row="2" x:Name="TreeEmpty" Visibility="Collapsed" Padding="20,0"
                            Background="{DynamicResource Panel}">
                        <TextBlock x:Name="TreeEmptyText" Style="{StaticResource Hint}" TextAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="10,8">
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                                HorizontalAlignment="Stretch" Click="New_Click" ToolTip="{loc:T Main.NewSessionHint}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ico}" Data="{StaticResource IcoPlus}" Margin="0,0,9,0"/>
                                <TextBlock Text="{loc:T Main.NewSession}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2" Background="{DynamicResource Panel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Only the tab headers are drawn here. The bodies stay parented
                     to TabHost below so the WebView2 terminal is not torn down
                     and rebuilt on every tab switch. -->
                <Border x:Name="TabStrip" Background="{DynamicResource ChromeAlt}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                    <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0"
                                SelectionChanged="Tabs_SelectionChanged">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                    <TabPanel IsItemsHost="True" Margin="8,6,8,0" Background="Transparent"/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Tip}">
                                    <Border x:Name="Tag" Width="3" Height="16" CornerRadius="2"
                                            Margin="0,0,9,0" VerticalAlignment="Center"
                                            Background="{Binding Accent}" Visibility="Collapsed"/>
                                    <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,9,0"
                                             VerticalAlignment="Center" Fill="{DynamicResource Idle}"/>
                                    <Border Style="{StaticResource Badge}" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource BadgeText}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="170"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Style="{StaticResource TabCloseButton}" Margin="11,0,-4,0"
                                            Tag="{Binding}" Click="CloseTab_Click"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Connected}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Success}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasColor}" Value="True">
                                        <Setter TargetName="Tag" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                    </TabControl>
                </Border>

                <Grid x:Name="TabHost" Grid.Row="1"/>

                <!-- Empty state: says what to do next, not just that nothing is open. -->
                <Border x:Name="EmptyState" Grid.RowSpan="2" Background="{DynamicResource Panel}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                        <Border Width="60" Height="60" CornerRadius="16" HorizontalAlignment="Center"
                                Background="{DynamicResource ChromeAlt}">
                            <Path Data="{StaticResource IcoTerminal}" Stretch="Uniform" Margin="17"
                                  Stroke="{DynamicResource Faint}" StrokeThickness="1.1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <TextBlock Text="{loc:T Main.EmptyTitle}" Style="{StaticResource TitleText}" FontSize="15"
                                   HorizontalAlignment="Center" Margin="0,18,0,0"/>
                        <TextBlock x:Name="EmptyHint" Style="{StaticResource Hint}" FontSize="12"
                                   TextAlignment="Center" Margin="0,8,0,0"
                                   Text="{loc:T Main.EmptyBody}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Border Style="{StaticResource Badge}" Padding="7,3">
                                <TextBlock Text="Ctrl+N" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                           Foreground="{DynamicResource Muted}"/>
                            </Border>
                            <TextBlock Text="{loc:T Main.NewSession}" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                       Margin="7,0,18,0"/>
                            <Border Style="{StaticResource Badge}" Padding="7,3">
                                <TextBlock Text="Ctrl+F" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                           Foreground="{DynamicResource Muted}"/>
                            </Border>
                            <TextBlock Text="{loc:T Common.Search}" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                       Margin="7,0,18,0"/>
                            <Border Style="{StaticResource Badge}" Padding="7,3">
                                <TextBlock Text="Enter" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                           Foreground="{DynamicResource Muted}"/>
                            </Border>
                            <TextBlock Text="{loc:T Main.Connect}" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                       Margin="7,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- =========================== STATUS BAR =========================== -->
        <Border Grid.Row="2" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0,6,0">
                <Button x:Name="StoreButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                        Height="20" Padding="6,0" Click="StorePath_Click"
                        ToolTip="{loc:T Main.OpenStoreFolder}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IcoSoft}" Data="{StaticResource IcoFolder}" Width="13" Height="13"
                              Margin="0,0,6,0"/>
                        <TextBlock x:Name="StoreText" Style="{StaticResource Hint}" FontSize="11"
                                   VerticalAlignment="Center" MaxWidth="300"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>
                <Ellipse x:Name="StatusDot" Width="6" Height="6" VerticalAlignment="Center"
                         Fill="{DynamicResource Idle}" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
