<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Limen</AssemblyName>
    <Product>Limen</Product>
    <Description>SSH terminal and SFTP file transfer client with saved credentials.</Description>
    <Version>0.0.1</Version>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <EmbeddedResource Include="Assets\xterm.js" />
    <EmbeddedResource Include="Assets\xterm.css" />
    <EmbeddedResource Include="Assets\addon-fit.js" />
    <None Include="Assets\LICENSE-xterm.txt" Link="LICENSE-xterm.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\LICENSE-addon-fit.txt" Link="LICENSE-addon-fit.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
