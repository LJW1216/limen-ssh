<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Limen"
                    xmlns:local="clr-namespace:Limen">

    <!-- ==================================================================
         DESIGN TOKENS
         Light values live here; ThemeManager swaps the same keys for dark,
         so every consumer must bind with DynamicResource.
         ================================================================== -->

    <SolidColorBrush x:Key="Chrome"          Color="#F3F4F6"/>  <!-- window / toolbar ground -->
    <SolidColorBrush x:Key="ChromeAlt"       Color="#E9EBEF"/>  <!-- inset strips, tracks -->
    <SolidColorBrush x:Key="Panel"           Color="#FFFFFF"/>  <!-- content surface -->
    <SolidColorBrush x:Key="PanelAlt"        Color="#F9FAFB"/>  <!-- header rows in a panel -->
    <SolidColorBrush x:Key="Line"            Color="#E3E5EA"/>  <!-- hairline separators -->
    <SolidColorBrush x:Key="LineStrong"      Color="#CBD0D8"/>  <!-- control outlines -->

    <SolidColorBrush x:Key="Ink"             Color="#16191D"/>
    <SolidColorBrush x:Key="Muted"           Color="#5B6472"/>
    <SolidColorBrush x:Key="Faint"           Color="#858D9A"/>
    <SolidColorBrush x:Key="DisabledInk"     Color="#AFB5BE"/>

    <SolidColorBrush x:Key="Accent"          Color="#1F6FEB"/>
    <SolidColorBrush x:Key="AccentHover"     Color="#1A61D1"/>
    <SolidColorBrush x:Key="AccentPressed"   Color="#154FAE"/>
    <SolidColorBrush x:Key="AccentSoft"      Color="#E8F0FE"/>
    <SolidColorBrush x:Key="OnAccent"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusRing"       Color="#8CBAF8"/>

    <SolidColorBrush x:Key="Success"         Color="#15A44A"/>
    <SolidColorBrush x:Key="Warn"            Color="#D97706"/>
    <SolidColorBrush x:Key="Danger"          Color="#D92D20"/>
    <SolidColorBrush x:Key="DangerSoft"      Color="#FDECEA"/>
    <SolidColorBrush x:Key="Idle"            Color="#B4BAC3"/>

    <SolidColorBrush x:Key="FieldBack"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBack"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonHover"     Color="#F2F4F7"/>
    <SolidColorBrush x:Key="ButtonPressed"   Color="#E4E7EC"/>
    <SolidColorBrush x:Key="ButtonDisabled"  Color="#F4F5F7"/>
    <SolidColorBrush x:Key="HoverBack"       Color="#F1F3F6"/>
    <SolidColorBrush x:Key="OverlayBack"     Color="#FBFBFC"/>
    <SolidColorBrush x:Key="ScrollThumb"     Color="#C6CBD3"/>
    <SolidColorBrush x:Key="ScrollThumbOver" Color="#A2A9B4"/>
    <SolidColorBrush x:Key="TerminalBack"    Color="#14161A"/>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, D2Coding, Malgun Gothic</FontFamily>

    <!-- ==================================================================
         ICONS — 16x16 stroke geometries painted with the owner's Foreground
         ================================================================== -->

    <Geometry x:Key="IcoPlus">M8,3.2 L8,12.8 M3.2,8 L12.8,8</Geometry>
    <Geometry x:Key="IcoPencil">M3.4,12.6 L3.4,10.2 L10.4,3.2 L12.8,5.6 L5.8,12.6 Z M9.2,4.4 L11.6,6.8</Geometry>
    <Geometry x:Key="IcoTrash">M2.8,4.4 L13.2,4.4 M6.4,4.4 L6.4,2.6 L9.6,2.6 L9.6,4.4 M4.2,4.4 L4.8,13.4 L11.2,13.4 L11.8,4.4 M6.9,6.9 L7.1,11.1 M9.1,6.9 L8.9,11.1</Geometry>
    <Geometry x:Key="IcoTerminal">M2.4,2.8 L13.6,2.8 L13.6,13.2 L2.4,13.2 Z M4.9,6 L7.3,8 L4.9,10 M8.4,10.6 L11.4,10.6</Geometry>
    <Geometry x:Key="IcoTransfer">M3.6,5.4 L11.2,5.4 M8.8,3 L11.2,5.4 L8.8,7.8 M12.4,10.6 L4.8,10.6 M7.2,8.2 L4.8,10.6 L7.2,13</Geometry>
    <Geometry x:Key="IcoArrowRight">M3.2,8 L12,8 M8.6,4.6 L12,8 L8.6,11.4</Geometry>
    <Geometry x:Key="IcoArrowLeft">M12.8,8 L4,8 M7.4,4.6 L4,8 L7.4,11.4</Geometry>
    <Geometry x:Key="IcoSearch">M11.6,7.2 A4.4,4.4 0 1 1 2.8,7.2 A4.4,4.4 0 1 1 11.6,7.2 M10.6,10.6 L13.6,13.6</Geometry>
    <Geometry x:Key="IcoRefresh">M13.2,8 A5.2,5.2 0 1 1 11.3,3.9 M11.3,3.9 L11.5,1.6 M11.3,3.9 L13.6,4.3</Geometry>
    <Geometry x:Key="IcoClose">M4.6,4.6 L11.4,11.4 M11.4,4.6 L4.6,11.4</Geometry>
    <Geometry x:Key="IcoUp">M8,12.8 L8,3.6 M4.2,7.4 L8,3.6 L11.8,7.4</Geometry>
    <Geometry x:Key="IcoSun">M11.4,8 A3.4,3.4 0 1 1 4.6,8 A3.4,3.4 0 1 1 11.4,8 M8,1.2 L8,2.6 M8,13.4 L8,14.8 M1.2,8 L2.6,8 M13.4,8 L14.8,8 M3.2,3.2 L4.2,4.2 M11.8,11.8 L12.8,12.8 M12.8,3.2 L11.8,4.2 M4.2,11.8 L3.2,12.8</Geometry>
    <Geometry x:Key="IcoMoon">M13.2,9.9 A5.7,5.7 0 1 1 6.1,2.8 A4.7,4.7 0 0 0 13.2,9.9 Z</Geometry>
    <Geometry x:Key="IcoFolder">M2.2,4 L6.2,4 L7.6,5.8 L13.8,5.8 L13.8,12.4 L2.2,12.4 Z</Geometry>
    <Geometry x:Key="IcoFolderPlus">M2.2,4 L6.2,4 L7.6,5.8 L13.8,5.8 L13.8,12.4 L2.2,12.4 Z M8,7.6 L8,10.6 M6.5,9.1 L9.5,9.1</Geometry>
    <Geometry x:Key="IcoServer">M2.4,3.2 L13.6,3.2 L13.6,7 L2.4,7 Z M2.4,9 L13.6,9 L13.6,12.8 L2.4,12.8 Z M4.6,5.1 L4.8,5.1 M4.6,10.9 L4.8,10.9</Geometry>
    <Geometry x:Key="IcoCopy">M5.6,5.6 L5.6,2.4 L13.6,2.4 L13.6,10.4 L10.4,10.4 M2.4,5.6 L10.4,5.6 L10.4,13.6 L2.4,13.6 Z</Geometry>
    <Geometry x:Key="IcoChevron">M6.2,3.8 L10.4,8 L6.2,12.2</Geometry>
    <Geometry x:Key="IcoStop">M5.2,5.2 L10.8,5.2 L10.8,10.8 L5.2,10.8 Z</Geometry>
    <Geometry x:Key="IcoPanel">M2.4,3 L13.6,3 L13.6,13 L2.4,13 Z M9.6,3 L9.6,13</Geometry>
    <Geometry x:Key="IcoFile">M4,2.4 L9.4,2.4 L12,5 L12,13.6 L4,13.6 Z M9.4,2.5 L9.4,5.2 L12,5.2</Geometry>
    <Geometry x:Key="IcoKey">M6.4,9.6 A2.7,2.7 0 1 1 6.38,9.6 Z M8.4,8.6 L13.4,3.6 M11,6 L12.4,7.4 M12.4,4.6 L13.8,6</Geometry>
    <Geometry x:Key="IcoCheck">M3.4,8.4 L6.5,11.4 L12.6,4.9</Geometry>

    <Style x:Key="Ico" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="StrokeThickness" Value="1.35"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Stroke"
                Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
    </Style>

    <Style x:Key="IcoSoft" TargetType="Path" BasedOn="{StaticResource Ico}">
        <Setter Property="StrokeThickness" Value="1.2"/>
        <Setter Property="Stroke" Value="{DynamicResource Faint}"/>
    </Style>

    <!-- ==================================================================
         TYPOGRAPHY
         ================================================================== -->

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FormLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="17"/>
    </Style>

    <!-- ==================================================================
         SCROLLBARS — thin overlay-style, themed. The stock WPF bars are the
         single loudest "unfinished app" tell, especially on dark surfaces.
         ================================================================== -->

    <Style x:Key="ScrollThumbV" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Background="{DynamicResource ScrollThumb}" CornerRadius="3" Margin="3,2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{DynamicResource ScrollThumbOver}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{DynamicResource ScrollThumbOver}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumbH" TargetType="Thumb" BasedOn="{StaticResource ScrollThumbV}">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Background="{DynamicResource ScrollThumb}" CornerRadius="3" Margin="2,3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{DynamicResource ScrollThumbOver}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{DynamicResource ScrollThumbOver}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbV}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumbH}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================================================================
         BUTTONS
         ================================================================== -->

    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Ring" CornerRadius="7" Margin="-2" Background="Transparent"
                                BorderBrush="{DynamicResource FocusRing}" BorderThickness="2" Opacity="0"/>
                        <Border x:Name="Back" CornerRadius="6" Background="{DynamicResource ButtonBack}"
                                BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource ButtonHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource ButtonPressed}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource ButtonDisabled}"/>
                            <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource Line}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Ring" CornerRadius="7" Margin="-2" Background="Transparent"
                                BorderBrush="{DynamicResource FocusRing}" BorderThickness="2" Opacity="0"/>
                        <Border x:Name="Back" CornerRadius="6" Background="{DynamicResource Accent}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentPressed}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource ButtonDisabled}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless toolbar action: quiet until hovered. -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Back" CornerRadius="6" Background="Transparent" BorderThickness="1"
                            BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource HoverBack}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource ButtonPressed}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource FocusRing}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Compact variant for the dense SFTP pane toolbars. -->
    <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="MiniIconButton" TargetType="Button" BasedOn="{StaticResource MiniButton}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="ToggleChip" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Back" CornerRadius="6" Background="Transparent" Padding="9,0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource HoverBack}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Session tag swatch: the fill is the tag colour, the ring is selection. -->
    <Style x:Key="ColorSwatch" TargetType="ToggleButton">
        <Setter Property="Width" Value="27"/>
        <Setter Property="Height" Value="27"/>
        <Setter Property="Margin" Value="0,0,7,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Ring" CornerRadius="9" BorderThickness="2" BorderBrush="Transparent"/>
                        <Border x:Name="Dot" Margin="4" CornerRadius="5.5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         TEXT INPUT
         ================================================================== -->

    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Back" CornerRadius="6" Background="{DynamicResource FieldBack}"
                            BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="Ghost" Margin="{TemplateBinding Padding}"
                                       Text="{Binding Path=(local:Ui.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource UiFont}" FontSize="12.5"
                                       Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Visibility="Collapsed"
                                       TextTrimming="CharacterEllipsis"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" BorderThickness="0"
                                          HorizontalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ghost" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource Faint}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Back" Property="BorderThickness" Value="1.6"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource ButtonDisabled}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MonoField" TargetType="TextBox" BasedOn="{StaticResource Field}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="Secret" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="local:Ui.TrackEmpty" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Back" CornerRadius="6" Background="{DynamicResource FieldBack}"
                            BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="Ghost" Margin="{TemplateBinding Padding}"
                                       Text="{Binding Path=(local:Ui.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource UiFont}" FontSize="12.5"
                                       Foreground="{DynamicResource Faint}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" BorderThickness="0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="local:Ui.IsEmpty" Value="True"/>
                                <Condition Property="IsFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Ghost" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource Faint}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Back" Property="BorderThickness" Value="1.6"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource ButtonDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         COMBOBOX
         ================================================================== -->

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Back" CornerRadius="6" Background="{DynamicResource FieldBack}"
                                            BorderBrush="{DynamicResource LineStrong}" BorderThickness="1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource Faint}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <Grid>
                                <ContentPresenter Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                <Path x:Name="Arrow" Data="M3.5,5.5 L7,9 L10.5,5.5" Width="14" Height="14"
                                      Stretch="None" StrokeThickness="1.4" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Stroke="{DynamicResource Faint}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </Grid>
                        </ToggleButton>
                        <Popup x:Name="Popup" Placement="Bottom" VerticalOffset="4"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,10,10"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="320">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.16" Color="#000000"/>
                                </Border.Effect>
                                <ScrollViewer><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Toggle" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Back" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource HoverBack}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         CHECKBOX / RADIO — stock WPF ones are Windows-classic and read as
         broken on a dark surface, so both are fully retemplated.
         ================================================================== -->

    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="4.5"
                                Background="{DynamicResource FieldBack}" BorderBrush="{DynamicResource LineStrong}"
                                BorderThickness="1.4" VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="{StaticResource IcoCheck}" Stretch="Uniform" Margin="2.5"
                                  Stroke="{DynamicResource OnAccent}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Opacity="0"/>
                        </Border>
                        <ContentPresenter x:Name="Label" Margin="9,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FocusRing}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/>
                            <Setter TargetName="Box" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="17" Height="17" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Fill="{DynamicResource FieldBack}"
                                     Stroke="{DynamicResource LineStrong}" StrokeThickness="1.4"/>
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource OnAccent}" Opacity="0"/>
                        </Grid>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/>
                            <Setter TargetName="Ring" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         TREEVIEW — session list
         ================================================================== -->

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style x:Key="TreeToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Path x:Name="Arrow" Data="M6,3.6 L10,7.5 L6,11.4" Width="15" Height="15" Stretch="None"
                              Stroke="{DynamicResource Faint}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              RenderTransformOrigin="0.52,0.5">
                            <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource Ink}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="IsExpanded" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Row" CornerRadius="6" Background="Transparent" Margin="0,1" MinHeight="28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton x:Name="Expander" Grid.Column="0" Style="{StaticResource TreeToggle}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBack}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsSelectionActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBack}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         LISTVIEW — SFTP file panes
         ================================================================== -->

    <Style TargetType="ListView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Row" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="26"
                            CornerRadius="4" Margin="2,0">
                        <GridViewRowPresenter VerticalAlignment="Center" Margin="6,0,0,0"
                                              Content="{TemplateBinding Content}"
                                              Columns="{Binding Path=View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBack}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoft}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="Selector.IsSelectionActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBack}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border x:Name="Back" Background="Transparent" BorderBrush="{DynamicResource Line}"
                                BorderThickness="0,0,0,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" Padding="3,0">
                                        <Rectangle Width="1" Fill="{DynamicResource Line}"/>
                                    </Border>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource HoverBack}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         TABS — the strip above the terminal / SFTP host
         ================================================================== -->

    <Style TargetType="TabControl">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Back" CornerRadius="7,7,0,0" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1,1,1,0" Padding="11,0" MinHeight="34">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <Rectangle x:Name="Underline" Height="2" VerticalAlignment="Bottom"
                                   Fill="{DynamicResource Accent}" Visibility="Collapsed" Margin="1,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource HoverBack}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource Panel}"/>
                            <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource Line}"/>
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TabCloseButton" TargetType="Button">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTip" Value="{loc:T Tab.Close}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Back" CornerRadius="4" Background="Transparent">
                        <Path Data="M4.6,4.6 L9.4,9.4 M9.4,4.6 L4.6,9.4" Width="14" Height="14" Stretch="None"
                              Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource DangerSoft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         MENUS / TOOLTIPS / POPOVERS
         ================================================================== -->

    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,12,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Back" CornerRadius="5" Background="Transparent" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" x:Name="Glyph" ContentSource="Icon"
                                              VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource Faint}" FontSize="11" VerticalAlignment="Center"
                                       Margin="18,0,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource HoverBack}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="8,5"/>
        <Setter Property="Background" Value="{DynamicResource Line}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{DynamicResource Line}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="6" Padding="9,5" Margin="0,0,10,10"
                            MaxWidth="340">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16" Color="#000000"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================================
         PROGRESS / SPLITTERS / SURFACES
         ================================================================== -->

    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="Background" Value="{DynamicResource ChromeAlt}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Border x:Name="PART_Track" CornerRadius="999" Background="{TemplateBinding Background}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="999" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"/>
                        <Border x:Name="Sweep" CornerRadius="999" Width="86" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="SweepShift" X="-90"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Sweep" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SweepRun">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SweepShift"
                                                         Storyboard.TargetProperty="X"
                                                         From="-90" To="260" Duration="0:0:1.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SweepRun"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Bar" Width="1" HorizontalAlignment="Center"
                                   Fill="{DynamicResource Line}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Cursor" Value="SizeWE"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Toolbar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Chrome}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="Divider" TargetType="Rectangle">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Fill" Value="{DynamicResource Line}"/>
        <Setter Property="Margin" Value="7,8"/>
    </Style>

    <!-- Small pill that labels a tab or row: SSH / SFTP, 로컬 / 원격. -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ChromeAlt}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="5,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>

</ResourceDictionary>
